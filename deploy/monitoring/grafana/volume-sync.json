      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(flux4swarm_migration_stopped_again_total[24h])) or vector(0)",
          "instant": true
        }
      ],
      "description": "Migrated services found running on Swarm (for example after a stack deploy) and scaled back to 0",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
