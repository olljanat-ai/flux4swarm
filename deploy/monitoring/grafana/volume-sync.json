    {
      "id": 18,
      "type": "table",
      "title": "Cutovers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "flux4swarm_migration_swarm_downtime_seconds",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "flux4swarm_migration_handed_over_timestamp_seconds * 1000",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Cutovers since the watcher started: the Swarm part of the downtime (scaled to 0 until the manifests were ready for Git) and when the service was handed over",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Swarm downtime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Handed over"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Handed over",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "service": 0,
              "namespace": 1,
              "workload": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "service": "Swarm service",
              "namespace": "Namespace",
              "workload": "Workload",
              "Value #A": "Swarm downtime",
              "Value #B": "Handed over"
            }
          }
        }
      ]
    }
