{
  "warnings": [
    "DaemonSet monitoring/agent: privileged containers are not supported by Swarm services",
    "Deployment monitoring/db: PersistentVolumeClaim \"db-data\" is not in the source; using a local volume",
    "Deployment monitoring/db: updates start the new task before stopping the old one, so both use the same volume for a moment; use strategy Recreate or rollingUpdate.maxSurge: 0 for databases and other single-writer workloads"
  ],
  "networks": [
    {
      "name": "monitoring_default",
      "labels": {
        "com.docker.stack.namespace": "monitoring"
      }
    }
  ],
  "services": [
    {
      "name": "monitoring_agent",
      "spec": {
        "Name": "monitoring_agent",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/agent:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Global": {}
        }
      }
    },
    {
      "name": "monitoring_db",
      "spec": {
        "Name": "monitoring_db",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/db:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            },
            "Mounts": [
              {
                "Type": "volume",
                "Source": "monitoring_db-data",
                "Target": "/var/lib/db",
                "VolumeOptions": {
                  "Labels": {
                    "com.docker.stack.namespace": "monitoring"
                  }
                }
              }
            ]
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Replicated": {
            "Replicas": 1
          }
        },
        "UpdateConfig": {
          "Parallelism": 1,
          "MaxFailureRatio": 0,
          "Order": "start-first"
        }
      }
    },
    {
      "name": "monitoring_migrate",
      "spec": {
        "Name": "monitoring_migrate",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/migrate:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "RestartPolicy": {
            "Condition": "on-failure",
            "MaxAttempts": 4
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "ReplicatedJob": {
            "MaxConcurrent": 2,
            "TotalCompletions": 3
          }
        }
      }
    },
    {
      "name": "monitoring_nosurge",
      "spec": {
        "Name": "monitoring_nosurge",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/nosurge:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Replicated": {
            "Replicas": 1
          }
        }
      }
    },
    {
      "name": "monitoring_once",
      "spec": {
        "Name": "monitoring_once",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/once:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "RestartPolicy": {
            "Condition": "none"
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "ReplicatedJob": {
            "MaxConcurrent": 1,
            "TotalCompletions": 1
          }
        }
      }
    },
    {
      "name": "monitoring_paused",
      "spec": {
        "Name": "monitoring_paused",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/paused:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "RestartPolicy": {
            "Condition": "on-failure"
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "ReplicatedJob": {
            "MaxConcurrent": 1,
            "TotalCompletions": 1
          }
        }
      },
      "suspended": true
    },
    {
      "name": "monitoring_singleton",
      "spec": {
        "Name": "monitoring_singleton",
        "Labels": {
          "com.docker.stack.namespace": "monitoring"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/singleton:1",
            "Labels": {
              "com.docker.stack.namespace": "monitoring"
            }
          },
          "Networks": [
            {
              "Target": "monitoring_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Replicated": {
            "Replicas": 1
          }
        },
        "UpdateConfig": {
          "Parallelism": 0,
          "MaxFailureRatio": 0,
          "Order": "stop-first"
        }
      }
    }
  ]
}
