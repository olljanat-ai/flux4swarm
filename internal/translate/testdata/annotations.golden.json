{
  "warnings": [
    "Deployment apps/worker: imagePullSecret \"missing\" not found"
  ],
  "networks": [
    {
      "name": "apps_default",
      "labels": {
        "com.docker.stack.namespace": "apps"
      }
    },
    {
      "name": "backend"
    }
  ],
  "services": [
    {
      "name": "legacy_worker",
      "spec": {
        "Name": "legacy_worker",
        "Labels": {
          "com.docker.stack.namespace": "apps",
          "extra": "yes"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "registry.example.com/worker:3",
            "Labels": {
              "com.docker.stack.namespace": "apps"
            }
          },
          "Placement": {
            "MaxReplicas": 1
          },
          "Networks": [
            {
              "Target": "backend"
            },
            {
              "Target": "apps_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Replicated": {
            "Replicas": 1
          }
        },
        "UpdateConfig": {
          "Parallelism": 1,
          "MaxFailureRatio": 0,
          "Order": "start-first"
        }
      },
      "registryAuth": {
        "https://index.docker.io/v1/": {
          "username": "hub",
          "password": "hubpass",
          "serveraddress": "https://index.docker.io/v1/"
        },
        "registry.example.com": {
          "username": "user",
          "password": "pass",
          "serveraddress": "https://registry.example.com/"
        }
      }
    }
  ]
}
