{
  "warnings": [
    "Deployment shop/api: PersistentVolumeClaim \"not-in-source\" is not in the source; using a local volume",
    "Deployment shop/api: updates start the new task before stopping the old one, so both use the same volume for a moment; use strategy Recreate or rollingUpdate.maxSurge: 0 for databases and other single-writer workloads"
  ],
  "networks": [
    {
      "name": "shop_default",
      "labels": {
        "com.docker.stack.namespace": "shop"
      }
    }
  ],
  "configs": [
    {
      "name": "shop_nginx_mime.types",
      "data": "types {}\n",
      "labels": {
        "com.docker.stack.namespace": "shop"
      }
    },
    {
      "name": "shop_nginx_nginx.conf",
      "data": "server {}\n",
      "labels": {
        "com.docker.stack.namespace": "shop"
      }
    }
  ],
  "secrets": [
    {
      "name": "shop_tls_tls.crt",
      "data": "CERT",
      "labels": {
        "com.docker.stack.namespace": "shop"
      },
      "source": "shop/tls"
    },
    {
      "name": "shop_tls_tls.key",
      "data": "KEY",
      "labels": {
        "com.docker.stack.namespace": "shop"
      },
      "source": "shop/tls"
    }
  ],
  "services": [
    {
      "name": "shop_api",
      "spec": {
        "Name": "shop_api",
        "Labels": {
          "com.docker.stack.namespace": "shop"
        },
        "TaskTemplate": {
          "ContainerSpec": {
            "Image": "example.com/shop/api:2.0",
            "Labels": {
              "com.docker.stack.namespace": "shop"
            },
            "Env": [
              "COLOR=blue",
              "LOG_LEVEL=debug",
              "DB_password=s3cret",
              "DB_user=app",
              "DB_PASSWORD_AGAIN=s3cret",
              "COLOR_AGAIN=blue"
            ],
            "Mounts": [
              {
                "Type": "volume",
                "Target": "/cache"
              },
              {
                "Type": "tmpfs",
                "Target": "/tmp",
                "TmpfsOptions": {
                  "SizeBytes": 67108864
                }
              },
              {
                "Type": "bind",
                "Source": "/var/log",
                "Target": "/var/log/host",
                "ReadOnly": true
              },
              {
                "Type": "volume",
                "Source": "shop_data",
                "Target": "/data",
                "VolumeOptions": {
                  "Labels": {
                    "backup": "daily",
                    "com.docker.stack.namespace": "shop"
                  },
                  "Subpath": "api",
                  "DriverConfig": {
                    "Name": "rexray",
                    "Options": {
                      "size": "10"
                    }
                  }
                }
              },
              {
                "Type": "volume",
                "Source": "shop_not-in-source",
                "Target": "/shared",
                "ReadOnly": true,
                "VolumeOptions": {
                  "Labels": {
                    "com.docker.stack.namespace": "shop"
                  }
                }
              }
            ],
            "Secrets": [
              {
                "File": {
                  "Name": "/tls/tls.crt",
                  "UID": "0",
                  "GID": "0",
                  "Mode": 256
                },
                "SecretID": "",
                "SecretName": "shop_tls_tls.crt"
              },
              {
                "File": {
                  "Name": "/tls/tls.key",
                  "UID": "0",
                  "GID": "0",
                  "Mode": 256
                },
                "SecretID": "",
                "SecretName": "shop_tls_tls.key"
              }
            ],
            "Configs": [
              {
                "File": {
                  "Name": "/etc/nginx/mime.types",
                  "UID": "0",
                  "GID": "0",
                  "Mode": 420
                },
                "ConfigID": "",
                "ConfigName": "shop_nginx_mime.types"
              },
              {
                "File": {
                  "Name": "/etc/nginx/nginx.conf",
                  "UID": "0",
                  "GID": "0",
                  "Mode": 420
                },
                "ConfigID": "",
                "ConfigName": "shop_nginx_nginx.conf"
              },
              {
                "File": {
                  "Name": "/etc/conf.d/default.conf",
                  "UID": "0",
                  "GID": "0",
                  "Mode": 292
                },
                "ConfigID": "",
                "ConfigName": "shop_nginx_nginx.conf"
              }
            ]
          },
          "Networks": [
            {
              "Target": "shop_default"
            }
          ],
          "ForceUpdate": 0
        },
        "Mode": {
          "Replicated": {
            "Replicas": 1
          }
        },
        "UpdateConfig": {
          "Parallelism": 1,
          "MaxFailureRatio": 0,
          "Order": "start-first"
        }
      }
    }
  ]
}
